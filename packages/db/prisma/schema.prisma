// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum Role{
  DEV
  OWNER
}

enum Status{
  Pending
  Connected
  Disconnected
  Blocked
}

model User {
  id              Int         @id @default(autoincrement())
  email           String      @unique
  name            String?
  password        String?
  job             String?
  // job is like hr or teacher
  role            Role?
  photo           String?
  owner           Owner?
  dev             Dev?
  phone           String?     
  createdAt       DateTime    @default(now())
  stars           Stars[]             
  senders         Connect[]    @relation("SentConnections")  
  receivers       Connect[]    @relation("ReceivedConnections")  
  notifications   Notifications[]
}


model Owner{
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id])
  projects       Project[]  
}

model Dev{
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  user          User      @relation(fields: [userId], references: [id])
  submissions   Submit[]
}

model Project{
  id            Int          @id @default(autoincrement())
  name          String       @unique
  description   String
  skillsreq     String?
  mainFeature   String
  refrenceLink  String?
  ownerId       Int          
  owner         Owner        @relation(fields: [ownerId],references: [id])
  submits      Submit[]
  star          Stars[]         
}

model Submit{
  id            Int            @id @default(autoincrement())
  projectId     Int
  project       Project        @relation(fields: [projectId],references: [id])
  devId         Int
  dev           Dev            @relation(fields: [devId],references: [id])
  liveLink      String         
  repoLink      String         @unique
  @@unique([projectId, devId])
  stars         Stars[]
}

model Stars {
  id            Int            @id @default(autoincrement())
  submitId      Int            
  submit        Submit         @relation(fields: [submitId],references: [id])
  ProjectId      Int            
  project       Project        @relation(fields: [ProjectId],references: [id])
  userId        Int            
  user          User           @relation(fields: [userId],references: [id])
  @@unique([ProjectId, userId])
}

model Connect {
  id             Int            @id @default(autoincrement())
  createdAt      DateTime       @default(now())
  status         Status
  senderId       Int
  sender         User           @relation("SentConnections",fields: [senderId], references: [id])  
  receiverId     Int
  receiver       User           @relation("ReceivedConnections",fields: [receiverId], references: [id])  
  @@unique([senderId, receiverId])
}

model Notifications {
  id             Int            @id @default(autoincrement())
  createdAt      DateTime       @default(now())
  message        String
  isRead         Boolean        @default(false)
  userId         Int
  user           User           @relation(fields: [userId], references: [id])
}

// in future, create one more model Application, devs can apply
