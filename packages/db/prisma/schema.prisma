// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  DEV
  OWNER
}

model User {
  id            Int         @id @default(autoincrement())
  email         String      @unique
  name          String?
  password      String
  job           String?
  role          Role?
  // role is like hr or teacher
  owner         Owner?
  dev           Dev?
  phone         BigInt?     @unique
  createdAt     DateTime    @default(now())
}


model Owner{
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id])
  projects       Project[]  
}

model Dev{
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  user          User      @relation(fields: [userId], references: [id])
  projects      Project[] 
}

model Project{
  id            Int          @id @default(autoincrement())
  name          String       @unique
  description   String
  skillsreq     String?
  devId         Int?         
  dev           Dev?         @relation(fields: [devId],references: [id])
  ownerId       Int          
  owner         Owner        @relation(fields: [ownerId],references: [id])
  // submits      Submit[]
}

