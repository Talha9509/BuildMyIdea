// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum Role{
  DEV
  OWNER
}

model User {
  id            Int         @id @default(autoincrement())
  email         String      @unique
  name          String?
  password      String?
  job           String?
  role          Role?
  photo         String?
  // role is like hr or teacher
  owner         Owner?
  dev           Dev?
  phone         String?     
  createdAt     DateTime    @default(now())
}


model Owner{
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id])
  projects       Project[]  
}

model Dev{
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  user          User      @relation(fields: [userId], references: [id])
  submissions   Submit[]
}

model Project{
  id            Int          @id @default(autoincrement())
  name          String       @unique
  description   String
  skillsreq     String?
  mainFeature   String
  refrenceLink  String?
  ownerId       Int          
  owner         Owner        @relation(fields: [ownerId],references: [id])
  submits      Submit[]
}

model Submit{
  id            Int            @id @default(autoincrement())
  projectId     Int
  project       Project        @relation(fields: [projectId],references: [id])
  devId         Int
  dev           Dev            @relation(fields: [devId],references: [id])
  liveLink      String         
  repoLink      String         @unique
  // maybe
  @@unique([projectId, devId])
}

// in future, create one more model Application, devs can apply
