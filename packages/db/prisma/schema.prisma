// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins","postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

enum Role {
  DEV
  OWNER
}

enum Status {
  Pending
  Rejected
  Connected
  Disconnected
  Blocked
}

enum RoleContributer {
  Leader
  Member
}

enum PaymentType {
  Deposit
  Payout
}

enum ProjectPaymentStatus {
  Unpaid
  Paid      
  Completed   
}

enum PaymentStatus {
  Processing
  Success
  Failed
}

model User {
  id              Int         @id @default(autoincrement())
  email           String      @unique
  username        String      @unique
  name            String?
  password        String?
  job             String?
  // job is like hr or teacher
  role            Role?
  photo           String?
  owner           Owner?
  dev             Dev?
  phone           String?     
  createdAt       DateTime    @default(now())
  stars           Stars[]             
  senders         Connect[]    @relation("SentConnections")  
  receivers       Connect[]    @relation("ReceivedConnections")  
  sentNotification      Notifications[]   @relation("SentNotifications") 
  recivedNotification   Notifications[]   @relation("ReceivedNotifications") 
  sentMessages          Messages[]        @relation("SentMessages")  
  receivedMessages      Messages[]        @relation("ReceivedMessages")  
}


model Owner{
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id])
  projects       Project[]  
  payments       Payments[]
}

model Dev{
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  user          User      @relation(fields: [userId], references: [id])
  contributions SubmissionContributor[]
  razorpayAccountId String?      @unique
}

model Project{
  id            Int          @id @default(autoincrement())
  name          String       @unique
  description   String
  skillsreq     String?
  mainFeature   String
  refrenceLink  String?
  ownerId       Int          
  owner         Owner        @relation(fields: [ownerId],references: [id])
  submits      Submit[]
  star          Stars[] 
  embedding     Unsupported("vector(1536)")?        
  Payments      Payments[]
  bounty        Int?
  equity        Int?
  paymentStatus  ProjectPaymentStatus    @default(Unpaid)
  winnerSubmitId Int?     @unique 
  winnerSubmit   Submit?  @relation("ProjectWinner", fields: [winnerSubmitId], references: [id])
}

model Submit{
  id            Int            @id @default(autoincrement())
  projectId     Int
  project       Project        @relation(fields: [projectId],references: [id])
  liveLink      String         
  repoLink      String         @unique
  stars         Stars[]
  NoofContributors   Int     @default(1)
  contributors    SubmissionContributor[]    
  wonProject       Project?     @relation("ProjectWinner")
}

model SubmissionContributor {
  submitId             Int
  submission          Submit        @relation(fields: [submitId],references: [id], onDelete: Cascade)
  devId                Int
  dev                  Dev            @relation(fields: [devId],references: [id], onDelete: Cascade)
  contributionPercent  Int
  projectId            Int
  contributionRole    RoleContributer   
  @@unique([projectId, devId])
  @@id([submitId, devId])
}

model Stars {
  id            Int            @id @default(autoincrement())
  submitId      Int            
  submit        Submit         @relation(fields: [submitId],references: [id])
  ProjectId      Int            
  project       Project        @relation(fields: [ProjectId],references: [id])
  userId        Int            
  user          User           @relation(fields: [userId],references: [id])
  @@unique([ProjectId, userId])
}

model Connect {
  id             Int            @id @default(autoincrement())
  createdAt      DateTime       @default(now())
  status         Status
  senderId       Int
  sender         User           @relation("SentConnections",fields: [senderId], references: [id])  
  receiverId     Int
  receiver       User           @relation("ReceivedConnections",fields: [receiverId], references: [id])  
  @@unique([senderId, receiverId])
}

model Notifications {
  id             Int            @id @default(autoincrement())
  createdAt      DateTime       @default(now())
  message        String
  isRead         Boolean        @default(false)
  receiverId     Int
  receiver       User           @relation("ReceivedNotifications",fields: [receiverId], references: [id])
  senderId       Int
  sender         User           @relation("SentNotifications",fields: [senderId], references: [id])
}

model Messages {
  id             Int            @id @default(autoincrement())
  senderId       Int
  sender         User           @relation("SentMessages",fields: [senderId], references: [id])  
  receiverId     Int
  receiver       User           @relation("ReceivedMessages",fields: [receiverId], references: [id]) 
  message        String
  createdAt      DateTime       @default(now())
}


model Payments {
  id             Int     @id @default(autoincrement())
  projectId      Int
  project        Project   @relation(fields: [projectId], references: [id])
  ownerId        Int
  owner          Owner     @relation(fields: [ownerId], references: [id])
  paymentType    PaymentType
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  status          PaymentStatus   @default(Processing)
  createdAt      DateTime     @default(now())
}

// in future, create one more model Application, devs can apply
